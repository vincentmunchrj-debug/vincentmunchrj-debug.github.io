# Copie ce fichier en .env et remplis avec les infos de TON projet Supabase
# (Supabase > Project Settings > API)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Optionnel : clé football-data.org pour récupérer les scores automatiquement
# (https://www.football-data.org/ — palier gratuit). Laisse vide pour saisie manuelle.
VITE_FOOTBALL_DATA_KEY=
